{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "Sempera Docs",
  "description": "Build, test and run Sempera phone agents from your own code. One hostname, one credential model, one contract.",
  "colors": {
    "primary": "#176e3c",
    "light": "#34d77e",
    "dark": "#176e3c"
  },
  "background": {
    "color": {
      "light": "#ffffff",
      "dark": "#171512"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/favicon.svg",
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hello@sempera.org"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open the App",
      "href": "https://app.sempera.org"
    }
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Sempera App",
          "icon": "layout-dashboard",
          "href": "https://app.sempera.org"
        },
        {
          "anchor": "OpenAPI contract",
          "icon": "braces",
          "href": "https://api.sempera.org/openapi.json"
        },
        {
          "anchor": "sempera.org",
          "icon": "globe",
          "href": "https://sempera.org"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "getting-started",
              "connect-mcp"
            ]
          },
          {
            "group": "Build an agent",
            "pages": [
              "agents",
              "branches",
              "personas",
              "scenarios",
              "memory-schema",
              "knowledge"
            ]
          },
          {
            "group": "Phone numbers",
            "pages": [
              "phone-plan",
              "sms",
              "connect-chatgpt",
              "connect-claude",
              "connect-codex",
              "connect-grok",
              "connect-muse"
            ]
          },
          {
            "group": "Calls",
            "pages": [
              "sessions-and-calls",
              "live-call-streams",
              "recordings",
              "api-chat",
              "widgets"
            ]
          },
          {
            "group": "Tools and integrations",
            "pages": [
              "tools-and-integrations",
              "snippets",
              "secrets-and-signing",
              "automations",
              "webhooks"
            ]
          },
          {
            "group": "Testing",
            "pages": [
              "tests-and-evals",
              "dispositions",
              "citation-schemas",
              "triage",
              "alerts"
            ]
          },
          {
            "group": "Workspace and security",
            "pages": [
              "workspaces",
              "security-and-privacy",
              "billing-boundaries",
              "app-features"
            ]
          },
          {
            "group": "SDKs and tools",
            "pages": [
              "developer-tools",
              "sdks",
              "supported-clients",
              "web-sdk"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "square-terminal",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "api-overview",
              "authentication",
              "errors-and-limits"
            ]
          }
        ],
        "openapi": {
          "source": "https://api.sempera.org/openapi.json",
          "overlays": [
            "openapi-overlay.json"
          ]
        }
      },
      {
        "tab": "Changelog",
        "icon": "history",
        "groups": [
          {
            "group": "Changelog",
            "pages": [
              "changelog"
            ]
          }
        ]
      }
    ]
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "python",
        "javascript"
      ],
      "defaults": "required"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/sempera-ai",
      "x": "https://x.com/SemperaAI"
    },
    "links": [
      {
        "header": "Docs for agents",
        "items": [
          {
            "label": "llms.txt",
            "href": "https://docs.sempera.org/llms.txt"
          },
          {
            "label": "llms-full.txt",
            "href": "https://docs.sempera.org/llms-full.txt"
          },
          {
            "label": "OpenAPI contract",
            "href": "https://api.sempera.org/openapi.json"
          }
        ]
      },
      {
        "header": "Sempera",
        "items": [
          {
            "label": "Sempera App",
            "href": "https://app.sempera.org"
          },
          {
            "label": "sempera.org",
            "href": "https://sempera.org"
          },
          {
            "label": "Support",
            "href": "mailto:hello@sempera.org"
          }
        ]
      }
    ]
  },
  "seo": {
    "indexing": "navigable"
  },
  "redirects": [
    {
      "source": "/mcp",
      "destination": "/connect-mcp"
    }
  ]
}
